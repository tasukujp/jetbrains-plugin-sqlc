<idea-plugin>
    <id>io.github.tasukujp.sqlc</id>
    <name>sqlc Support</name>
    <vendor>tasukujp</vendor>
    <description><![CDATA[
        Removes false SQL resolve errors for sqlc parameters and highlights them: <code>@name</code>,
        <code>$1</code>, <code>sqlc.arg()</code>, <code>sqlc.narg()</code>, <code>sqlc.slice()</code> and
        <code>sqlc.embed()</code>. Applies only to files listed in the <code>queries</code> of sqlc.yaml.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>
    <extensions defaultExtensionNs="com.intellij">
        <lang.inspectionSuppressor language="SQL" implementationClass="io.github.tasukujp.sqlc.SqlcInspectionSuppressor"/>
        <annotator language="SQL" implementationClass="io.github.tasukujp.sqlc.SqlcParameterAnnotator"/>
        <colorSettingsPage implementation="io.github.tasukujp.sqlc.SqlcColorSettingsPage"/>
        <!-- SQL の Parameter 色は Dark 系で通常の文字色と同じなので、目立つ既定色を持たせる -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/SqlcDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/SqlcDarcula.xml"/>
        <additionalTextAttributes scheme="Dark" file="colorSchemes/SqlcDarcula.xml"/>
    </extensions>
</idea-plugin>
